<Window x:Class="WPFProgramMain.CustomControlExample.CustomControlExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFProgramMain.CustomControlExample"
        mc:Ignorable="d"
        Title="Custom Control Example" Height="450" Width="800">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Using the CustomLabelControl -->
        <local:CustomLabelControl LableText="Hello, Custom Control!" Width="300" Height="50" />
        <local:CustomLabelControl LableText="This is another example." Width="300" Height="50" />
    </StackPanel>

</Window>
