<Window x:Class="MVVMCore.Challanges.CustomStyleOnControls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVMCore.Challanges"
        mc:Ignorable="d"
        Title="CustomStyleOnControls" Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>



                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="/../CommonUtils;component/ResourceDictionaries/CommonComponentStyle.xaml"/>
                            </ResourceDictionary.MergedDictionaries>
                        </ResourceDictionary>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>



            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Name="x_txtblock" Text="Small TextBlock Reg" Width="150" Height="20"  Grid.Row="0" Margin="5" HorizontalAlignment="Left" Style="{DynamicResource SmallTextBlockReg}"></TextBlock>
        <Button Name="x_buttonSmallReg" Content="Small Button" Width="150" Height="30"  Grid.Row="1" Margin="5" HorizontalAlignment="Left" Style="{DynamicResource SmallButtonReg}"></Button>
        <Button Name="x_buttonMedium" Content="Medium Button" Width="150" Height="30"  Grid.Row="2" Margin="5" HorizontalAlignment="Left" Style="{DynamicResource LargeButtonReg}"></Button>
        <Button Name="x_buttonLarge" Content="Large Button" Width="150" Height="30" Grid.Row="3" Margin="5" HorizontalAlignment="Left" Style="{DynamicResource MediumButtonMed}"></Button>
        
    </Grid>
</Window>
