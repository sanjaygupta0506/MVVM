<Window x:Class="MVVMCore.Challanges.SearchTextBoxUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="clr-namespace:MVVMCore.Challanges"
        
        mc:Ignorable="d"
        Title="SearchTextBox" Height="423" Width="487">
    
    <Grid >
        <Border BorderBrush="Black"
            BorderThickness="1"
            VerticalAlignment="Center"
            >

            <StackPanel Margin="5"
                    Orientation="Horizontal" Width="200">

                <Image Source="pack://application:,,,/CommonUtils;component/Images/search_dark.png" 
                   Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <TextBox Width="200"
                       Margin="1 0 0 0" />

            </StackPanel>


        </Border>
    </Grid>
</Window>
