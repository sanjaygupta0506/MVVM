<Window x:Class="MVVMCore.Challanges.InfragisticDockManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:igDock="http://infragistics.com/DockManager"
             xmlns:igWindows="http://infragistics.com/Windows"
             MinWidth="300"
             MinHeight="300">

    <Window.CommandBindings>
        
    </Window.CommandBindings>

    <Window.Resources>
        <ResourceDictionary>
           
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <LinearGradientBrush x:Key="NormalBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientBrush.GradientStops>
                    <GradientStopCollection>
                        <GradientStop Color="#FFF" Offset="0.0"/>
                        <GradientStop Color="#CCC" Offset="1.0"/>
                    </GradientStopCollection>
                </GradientBrush.GradientStops>
            </LinearGradientBrush>

            <ControlTemplate x:Key="NewButtonTabGroupPaneTemplate" TargetType="{x:Type igDock:TabGroupPane}">
                <DockPanel ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                    <DockPanel x:Name="PART_HeaderArea" Panel.ZIndex="1" DockPanel.Dock="{TemplateBinding TabStripPlacement}">
                        <ItemsPresenter x:Name="PART_TabHeaderPanel" Margin="5,2,10,0" KeyboardNavigation.TabIndex="1" DockPanel.Dock="Left" />
                    </DockPanel>
                    <Border x:Name="InnerBorder" BorderThickness="0"  CornerRadius="1" BorderBrush="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedPaneInnerBorderFillKey}}" SnapsToDevicePixels="True" >
                        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" x:Name="PART_SelectedContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" Content="{TemplateBinding SelectedContent}" />
                    </Border>
                </DockPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="igDock:XamDockManager.PaneLocation" Value="Document">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="TabStripPlacement" Value="Top" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar Name="x_toolbarMain"
                 Grid.Row="0"
                 DockPanel.Dock="Top">
            
            <ToolBar.Resources>
                <Style TargetType="Image">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="Height" Value="16" />
                </Style>
            </ToolBar.Resources>

            <!--Group 1-->
            <StackPanel Margin="4" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!--<TextBlock x:Name="txtShow" Text="Show:"  VerticalAlignment="Center"/>-->
                <ContentControl Name="x_familyFilterContainer"/>
                <ComboBox Name="m_fComboBox" IsHitTestVisible="False"/>
            </StackPanel>
            <Separator x:Name="x_fSeprator" Height="34" Padding="0,0,8,0"/>

            <!--Group 2-->
            <StackPanel Margin="4" Orientation="Horizontal" VerticalAlignment="Center" Height="25">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!--<TextBlock x:Name="txtShow1" VerticalAlignment="Center" Text="Show:"  Margin="0,0,10,0"/>-->
                <ContentControl Name="x_channelFilterContainer" Background="{Binding}"/>

            </StackPanel>
            <Separator x:Name="x_tSeprator" Height="34"/>

            <!--Group 3-->
            <Border Name="HeaderBorder"
              BorderBrush="LightGray">

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBox x:Name="x_searchTextBox"
                             Width="200" Background="Transparent"
                             Height="32" Margin="0,0,5,0"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             AcceptsReturn="False"
                             IsEnabled="True"
                             IsReadOnly="False"
                             TextAlignment="Left"
                             TextWrapping="NoWrap">
                        <TextBox.ToolTip>Find A Packet</TextBox.ToolTip>
                    </TextBox>
                    <Button Name="x_findPrevPacket"  BorderThickness="0" Width="42" Height="34">
                        <Button.ToolTip>Find Previous Packet</Button.ToolTip>
                        <Viewbox Width="16" Height="16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                            <Canvas Height="16" Width="16">
                                <Line X1="15.5" Y1="16" X2="15.5" Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10"/>
                                <Polygon Points="12.5 1 1 8 12.5 15 12.5 1" Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10" />
                            </Canvas>
                        </Viewbox>
                        <!--<Image Source="pack://application:,,,/ProtocolViewer;component/Resources/FindPrev.png" HorizontalAlignment="Center" VerticalAlignment="Center" />-->
                    </Button>
                    <Button Name="x_findNextPacket"   BorderThickness="0" Width="42" Height="34" >
                        <Button.ToolTip>Find Next Packet</Button.ToolTip>
                        <Viewbox Width="16" Height="16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                            <Canvas Height="16" Width="16">
                                <Polygon Points="3.5 15 15 7.5 3.5 1 3.5 15" Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10" />
                                <Line X1="0.5" Y1="16" X2="0.5" Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10"/>
                            </Canvas>
                        </Viewbox>
                        <!--<Image Source="pack://application:,,,/ProtocolViewer;component/Resources/FindNext.png" HorizontalAlignment="Center" VerticalAlignment="Center" />-->
                    </Button>
                </StackPanel>
            </Border>
            <Separator x:Name="x_bSeprator" Height="34" Padding="0,0,8,0" />

            <!--Group 4 -->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Name="x_setup"  BorderThickness="0" Width="42" Height="34" >
                    <Button.ToolTip>Setup</Button.ToolTip>
                    <Image Source="SetupIcon.png" />
                </Button>
                <Button Name="x_trigger"  BorderThickness="0" Width="42" Height="34"  >
                    <Button.ToolTip>Trigger</Button.ToolTip>
                    <Image Source="TriggerIcon.png"/>
                </Button>
            </StackPanel>

            <!--Group 5 Run-->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Name="x_run" BorderThickness="0" Width="42" Height="34" >
                    <Button.ToolTip>Run</Button.ToolTip >
                    <!--<Image Source="pack://application:,,,/ProtocolViewer;component/Resources/StartIcon.png" />-->
                    <Viewbox Height="16" Width="16">
                        <Canvas Height="16" Width="16">
                            <Polygon Points="0 16 16 8 0 0 0 16" Fill="#40b449"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

            <!--Group 6 Stop-->
            <StackPanel Orientation="Horizontal">
                <Button Name="x_stop" BorderThickness="0" Width="42" Height="34" >
                    <Button.ToolTip>Stop</Button.ToolTip>
                    <!--<Image Source="pack://application:,,,/ProtocolViewer;component/Resources/StopIcon.png" />-->
                    <Viewbox Height="16" Width="16">
                        <Canvas Height="16" Width="16">
                            <Rectangle Width="16" Height="16" Fill="#ed2726"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
            <Separator x:Name="x_mSeprator" Height="34" Padding="0,0,8,0" />

            <!--Group 7-->
            <StackPanel Name="x_filterPacket" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ToggleButton x:Name="x_filterPacketsButton"
                          BorderThickness="0" >
                    <ToggleButton.ToolTip>Simple Packet Filter</ToggleButton.ToolTip>
                    <Viewbox Width="16" Height="16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                        <Canvas Height="16" Width="16">
                            <Polygon Points="15 0.5 1 0.5 6.5 9.5 6.5 15.5 9.5 15.5 9.5 9.5 15 0.5"  Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10"/>
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                
            </StackPanel>
            <Separator x:Name="x_cSeprator" Height="34" Padding="0,0,8,0"/>

            <!--Group 8-->
            <StackPanel Name="x_colResize" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Name="x_columnResizeByContent"  BorderThickness="0" >
                    <Button.ToolTip>Resize columns based on their content</Button.ToolTip>
                    <Viewbox Width="16" Height="16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                        <Canvas Height="16" Width="16">
                            <Polygon Points="2.5 5.5 4.5 8 2.5 10.5 2.5 5.5" Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10"/>
                            <Line X1="2" Y1="8" Y2="8" Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10"/>
                            <Line X1="5.5" X2="5.5" Y2="16" Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10"/>
                            <Line X1="10.5" X2="10.5" Y2="16"  Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10"/>
                            <Polygon Points="13.5 10.5 11.5 8 13.5 5.5 13.5 10.5" Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10"/>
                            <Line X1="14" Y1="8" X2="16" Y2="8" Stroke="{DynamicResource IconDarkBackgroundColor}" StrokeMiterLimit="10"/>

                        </Canvas>
                    </Viewbox>
                    <!--<Image Source="pack://application:,,,/ProtocolViewer;component/Resources/ColumnResize.png" />-->
                </Button>

                <Button Name="x_columnResizeByHeader" BorderThickness="0" >
                    <Button.ToolTip>Resize columns based on their header</Button.ToolTip>
                    <Image Source="ColumnResizeHeader.png" />
                </Button>

            </StackPanel>
            <Separator x:Name="x_rSeprator" Height="34" Padding="0,0,8,0" />

            <!--Group 9-->
            <StackPanel Name="x_toggleButton" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ToggleButton Name="x_MarkerVisibleToggleButton"
                          
                          BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle marker Visibility</ToggleButton.ToolTip>
                    <Image Source="MarkerIcon.png" />

                </ToggleButton>

                <ToggleButton Name="x_ToolTipVisibleToggleButton"
                          BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle tooltip visibility</ToggleButton.ToolTip>
                    <Image Source="ToolTipsIcon.png" />
                </ToggleButton>

                <ToggleButton Name="x_detailsPaneVisibleButton"
                          BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle Details Pane visibility</ToggleButton.ToolTip>
                    <Image Source="PaneDetailsIcon.png" />
                </ToggleButton>

                <ToggleButton Name="x_headerPaneVisibleButton"
                           BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle Header Pane visibility</ToggleButton.ToolTip>
                    <Image Source="PaneHeaderIcon.png" />
                </ToggleButton>

                <ToggleButton Name="x_payloadPaneVisibleButton"
                          BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle Payload Pane visibility</ToggleButton.ToolTip>
                    <Image Source="PanePayloadIcon.png" />
                </ToggleButton>

                <ToggleButton Name="x_lanesPaneVisibleButton"
                         BorderThickness="0" >
                    <ToggleButton.ToolTip>
                        <TextBlock Text="{Binding LanesTabIconToolTip}" />
                    </ToggleButton.ToolTip>
                    <Image Source="{Binding LanesTabIcon}" />
                </ToggleButton>

                <ToggleButton Name="x_trafficOverviewPaneVisibleButton"
                          BorderThickness="0">
                    <ToggleButton.ToolTip>Toggle Traffic Overview Pane visibility</ToggleButton.ToolTip>
                    <Image Source="PaneTrafficOverviewIcon.png" />
                </ToggleButton>

                <ToggleButton Name="x_imageViewPaneVisibleButton"
                          
                          BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle Image View Pane visibility</ToggleButton.ToolTip>
                    <Image Source="PaneImageViewIcon.png" />
                </ToggleButton>

                <ToggleButton Name="x_ltssmOverviewPaneVisibleButton"
                          BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle LTSSM Overview Pane visibility</ToggleButton.ToolTip>
                    <Image Source="PaneLtssmOverviewIcon.png" />
                </ToggleButton>

                <ToggleButton Name="x_transactionDecodePaneVisibleButton"
                         BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle Transaction Decode Pane visibility</ToggleButton.ToolTip>
                    <Image Source="PaneTransactionDecodeIcon.png" />
                </ToggleButton>

                <ToggleButton Name="x_testAssertionPaneVisibleButton"
                          BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle Test Assertion Pane visibility</ToggleButton.ToolTip>
                    <Image Source="PaneTestAssertionIcon.png" />
                </ToggleButton>

                <ToggleButton Name="x_pcieperformanceOverviewPaneVisibleButton"
                         BorderThickness="0" >
                    <ToggleButton.ToolTip>Toggle PCIe Performance Overview Pane visibility</ToggleButton.ToolTip>
                    <Image Source="PanePCIePerformanceOverviewIcon.png" />
                </ToggleButton>
            </StackPanel>

            <!--Group 10-->
            <StackPanel Name="x_compareWindow" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Name="x_compareWindowButton"  BorderThickness="0" >
                    <Button.ToolTip>Open new Compare Window</Button.ToolTip>
                    <Image Source="PaneCompareIcon.png" />
                </Button>
                <Button Name="x_exportWindowButton" BorderThickness="0" >
                    <Image Source="CSV_Export.png" />
                    <Button.ToolTip>Export Protocol Data in CSV format</Button.ToolTip>
                </Button>
            </StackPanel>
            <Separator x:Name="x_pSeprator" Height="34" Padding="0,0,8,0"  />

            <!--Group 11-->
            <StackPanel Name="x_spfavoriteLayouts" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=GraphNotRunning}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            </StackPanel>

            <MenuItem  Header="Open..." />
            <MenuItem x:Name="xaml_saveViewerLayout"
                                  
                                  Header="Save as..." />
            
            <Separator x:Name="x_firstSeparator" />
            <MenuItem Header="Layout history empty" IsEnabled="false" />
            <Separator x:Name="x_secondSeparator" />

                       
            <Separator />
            <Grid VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding Path=ComputeAllOnRun, Mode=TwoWay}" Visibility="Hidden">Compute All on Run</CheckBox>
            </Grid>
            <Separator />

            <Grid VerticalAlignment="Center">
                <CheckBox Name="x_cbxtheme" Visibility="Hidden"></CheckBox>
            </Grid>
        </ToolBar>

        <igDock:XamDockManager Grid.Row="1" Name="x_dockManager"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               FontSize="14" FontFamily="Roboto" FontWeight="Medium" Background="Transparent">
            <igDock:XamDockManager.Resources>
                <Style TargetType="igDock:PaneTabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="igDock:PaneTabItem">
                                <TextBlock Name="Panel1" Height="34">
                                    <Border x:Name="x_MyBorder"
                                            Height="34"
                                            Background="{DynamicResource TabNormalBackgroundColor}"
                                            BorderBrush="{DynamicResource TabBorderBrush}"
                                            BorderThickness="0,0,0,0">
                                        <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked,ElementName=x_cbxtheme}" Value="False">
                                            <Setter Property="Background" Value="#EBEFF7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked,ElementName=x_cbxtheme}" Value="True">
                                            <Setter Property="Background" Value="#393941"/>
                                            </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        TextBlock.Foreground="{DynamicResource TabHeaderNormalForegroundColor}"
                                        Margin="12,0,12,0"
                                        ContentSource="Header"
                                        /></Border>
                                </TextBlock>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="x_MyBorder" Property="Background" Value="{DynamicResource TabHoverBackgroundColor}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="x_MyBorder" Property="Background" Value="{DynamicResource TabActiveBackgroundColor}"/>
                                        <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{DynamicResource TabHeaderActiveForegroundColor}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </igDock:XamDockManager.Resources>
            <igDock:DocumentContentHost Name="x_DocumentContentHost" Background="red" Margin="0,-5,0,0">
                <igDock:SplitPane Name="x_dockManagerSplitPane" SplitterOrientation="Horizontal">
                    <igDock:TabGroupPane  x:Name="x_tabGroupPanePackets" Padding="0" >
                        <!--Template="{StaticResource NewButtonTabGroupPaneTemplate}"-->
                        <igDock:ContentPane Name="x_contentPanePackets" 
                                            AllowClose="False" 
                                            
                                           
                                            AllowPinning="False"
                                            Header="Packets">

                        </igDock:ContentPane>
                    </igDock:TabGroupPane>
                    <!--<igDock:SplitPane Name="x_dockManagerSplitDetailsPane" SplitterOrientation="Vertical">-->
                        <igDock:TabGroupPane Name="x_dockManagerSubTabPane">
                            <igDock:ContentPane Name="x_contentPaneDetails"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                                Header="{Binding Path=HeaderName}"
                                                />
                            <igDock:ContentPane Name="x_contentPaneHeader"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                                
                                                Header="Header"
                                                />
                            <igDock:ContentPane Name="x_contentPanePayload"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                                
                                                Header="Payload"
                                                />
                            <igDock:ContentPane Name="x_contentPaneLanes"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                               
                                                Header="{Binding Path=LanesTabName}"
                                                >
                                
                            </igDock:ContentPane>

                            <igDock:ContentPane Name="x_contentPaneTrafficOverview"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                                
                                                Header="Traffic Overview"
                                                />

                            <igDock:ContentPane Name="x_contentPaneImageView"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                               
                                                Header="Image View"
                                                />

                            <igDock:ContentPane Name="x_contentPaneLtssmOverview"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                               
                                                Header="LTSSM Overview"
                                                />
                            <igDock:ContentPane Name="x_contentPaneTransactionDecode"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                               
                                                Header="Transaction Decode"
                                                />
                            <igDock:ContentPane Name="x_contentPaneTestAssertion"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                                
                                                Header="Test Assertion"
                                                 />
                            <igDock:ContentPane Name="x_contentPanePCIePerformanceOverview"
                                                AllowDockingFloating="True"
                                                AllowFloatingOnly="False"
                                                AllowPinning="False"
                                                CloseAction="HidePane"
                                                
                                                Header="Performance Overview"
                                                />
                        </igDock:TabGroupPane>
                    <!--</igDock:SplitPane>-->
                </igDock:SplitPane>
            </igDock:DocumentContentHost>
        </igDock:XamDockManager>

        <igDock:XamDockManager Grid.Row="2" Name="x_dockManager1"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               FontSize="14" FontFamily="Roboto" FontWeight="Medium">
            <igDock:XamDockManager.Resources>
                <Style TargetType="igDock:PaneTabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="igDock:PaneTabItem">
                                <TextBlock Name="Panel1" Height="34">
                                    <Border x:Name="x_MyBorder"
                                            Height="34"
                                            Background="{DynamicResource TabNormalBackgroundColor}"
                                            BorderBrush="{DynamicResource TabBorderBrush}"
                                            BorderThickness="0,0,0,0">
                                        <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked,ElementName=x_cbxtheme}" Value="False">
                                            <Setter Property="Background" Value="#EBEFF7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked,ElementName=x_cbxtheme}" Value="True">
                                            <Setter Property="Background" Value="#393941"/>
                                            </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        TextBlock.Foreground="{DynamicResource TabHeaderNormalForegroundColor}"
                                        Margin="12,0,12,0"
                                        ContentSource="Header"
                                        /></Border>
                                </TextBlock>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="x_MyBorder" Property="Background" Value="{DynamicResource TabHoverBackgroundColor}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="x_MyBorder" Property="Background" Value="{DynamicResource TabActiveBackgroundColor}"/>
                                        <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{DynamicResource TabHeaderActiveForegroundColor}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
