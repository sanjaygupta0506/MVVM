<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" 
               x:Class="MainApplication.WPF_MVVM._6._API.Rest_API.WPFRestAPI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM._6._API.Rest_API"
        mc:Ignorable="d"
        Title="WPF With Rest API 1" Height="450" Width="800" Left="8" Top="62">
    <Grid>
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>-->
        <!--<Button Grid.Row="0" Content="Fetch Data" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Click="FetchData_Click" Margin="346,6,346,0"/>-->
        <!--<TextBlock x:Name="ResultTextBlock" Text="Response will appear here..." TextWrapping="Wrap" Margin="20,60,20,20"/>-->

        <DataGrid ItemsSource="{Binding Posts}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="UserID" Binding="{Binding UserID}" Width="30"/>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="30"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="Auto"/>
                <DataGridTextColumn Header="Body" Binding="{Binding Body}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:WslDialog>
