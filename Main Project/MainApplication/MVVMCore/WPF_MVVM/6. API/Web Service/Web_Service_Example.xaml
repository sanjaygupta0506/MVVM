<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" 
               x:Class="MainApplication.WPF_MVVM._6._API.Web_Service.Web_Service_Example"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM._6._API.Web_Service"
        mc:Ignorable="d"
        Title="Web_Service_Example" Height="600" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="360"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <DataGrid Grid.Row="0" Grid.Column="0" x:Name="UsersDataGrid" AutoGenerateColumns="True"  Grid.ColumnSpan="5"/>
        <Label Grid.Row="1" Grid.Column="0" Name="ID" Width="100" Content="ID"/>
        <Label Grid.Row="2" Grid.Column="0" Name="UserName" Content="UserName" Width="100" />
        <Label Grid.Row="3" Grid.Column="0" Name="Mobile" Content="Mobile" Width="100"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="x_ID" Width="100" Margin="2"/>
        <TextBox Grid.Row="2" Grid.Column="1" Name="x_UName" Width="100" Margin="2"/>
        <TextBox Grid.Row="3" Grid.Column="1" Name="x_Mobile" Width="100" Margin="2"/>
        <Button Name="x_Select" Content="Select"/>
        <Button Name="x_Insert" Content="Insert"/>
   
    </Grid>
</ui:WslDialog>
