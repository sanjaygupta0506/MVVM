<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MainApplication.WPF_MVVM.SOLID_Princliple.SRP.SRP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM.SOLID_Princliple.SRP"
        mc:Ignorable="d"
        Title="Single Responsibility Principle" Height="450" Width="800" Left="8" Top="62">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Name="x_Basic" Grid.Row="0" Grid.Column="0" Content="Basic"/>
        <Label Name="x_HRA" Grid.Row="1" Grid.Column="0" Content="HRA"/>
        <Label Name="x_OA" Grid.Row="2" Grid.Column="0" Content="Other Allowance"/>
        <Label Name="x_Total" Grid.Row="3" Grid.Column="0" Content="Total"/>
        <TextBox x:Name="tbBasic" Grid.Row="0" Grid.Column="1"></TextBox>
        <TextBox x:Name="tbHRA" Grid.Row="1" Grid.Column="1"></TextBox>
        <TextBox x:Name="tbOA" Grid.Row="2" Grid.Column="1" MouseLeave="tbOA_MouseLeave"></TextBox>
        <TextBox x:Name="tbSalary" Grid.Row="3" Grid.Column="1"></TextBox>
        <TextBox x:Name="tbBonus" Grid.Row="3" Grid.Column="2"></TextBox>

    </Grid>
</ui:WslDialog>
