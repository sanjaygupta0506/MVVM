<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MainApplication.WPF_MVVM.WPFMVVMBasic.Layouts.Layout_Canvas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM.WPFMVVMBasic.Layouts"
        mc:Ignorable="d"
        Title="Layout Canvas" Height="450" Width="800" Left="8" Top="62">
    <Canvas>
        <Label Canvas.Top="30" Canvas.Left="20" Style="{DynamicResource LabelStyleDefault}">Enter Here</Label>
        <TextBox Canvas.Top="30" Canvas.Left="250" Width="150" Style="{DynamicResource TextboxStyleDefault}"></TextBox>
        <Button Canvas.Top="100" Canvas.Left="250" Name="x_Submit" Content="Add" Width="150" Height="30" VerticalAlignment="Top" HorizontalAlignment="Right" ></Button>
    </Canvas>
