<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MainApplication.WPF_MVVM.WPFMVVMBasic.Layouts.Layout_Grid"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM.WPFMVVMBasic.Layouts" xmlns:model="clr-namespace:MVVMCore.Model" d:DataContext="{d:DesignInstance Type=model:INotifyPropertyChangedExampleModel}"
               mc:Ignorable="d"
        Title="Layout Grid" Height="220" Width="280" Left="8" Top="62">
    <Grid Name="MCGrid" Width="280" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid Background="AliceBlue" VerticalAlignment="Top" ShowGridLines="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="25" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>
            <Border/>
            <TextBlock FontSize="14" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Foreground="Green"   
            Text="Author Name" />
            <TextBlock FontSize="14" FontWeight="Bold" Grid.Row="0" Grid.Column="1" Foreground="Green"   
            Text="Age" />
            <TextBlock FontSize="14" FontWeight="Bold" Grid.Row="0" Grid.Column="2" Foreground="Green"   
            Text="Book" />

            <TextBlock FontSize="12" Grid.Row="1" Grid.Column="0" Foreground="Green">Mahesh Chand</TextBlock>
            <TextBlock FontSize="12" Grid.Row="1" Grid.Column="1" Foreground="Green">33</TextBlock>
            <TextBlock FontSize="12" Grid.Row="1" Grid.Column="2" Foreground="Green">GDI+ Programming</TextBlock>
            <TextBlock FontSize="12" Grid.Row="2" Grid.Column="0" Foreground="Green">Mike Gold</TextBlock>
            <TextBlock FontSize="12" Grid.Row="2" Grid.Column="1" Foreground="Green">35</TextBlock>
            <TextBlock FontSize="12" Grid.Row="2" Grid.Column="2" Foreground="Green">Programming C#</TextBlock>
                
        </Grid>


        <Grid Background="Beige" Margin="0,80,0,0" ShowGridLines="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="auto" />

            </Grid.ColumnDefinitions>
           
            <TextBlock FontSize="14" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Foreground="Green"   
            Text="First Name" VerticalAlignment="Top" />
            <TextBlock FontSize="14" FontWeight="Bold" Grid.Row="1" Grid.Column="0" Foreground="Green"   
            Text="Last Name" VerticalAlignment="Top" />
            <TextBlock FontSize="14" FontWeight="Bold" Grid.Row="2" Grid.Column="0" Foreground="Green"   
            Text="Address" VerticalAlignment="Top"/>

            <TextBox FontSize="14" FontWeight="Bold" Grid.Row="0" Grid.Column="1" 
            />
            <TextBox FontSize="14" FontWeight="Bold" Grid.Row="1" Grid.Column="1" 
           VerticalAlignment="Top" />
            <TextBox FontSize="14" FontWeight="Bold" Grid.Row="2" Grid.Column="1" 
            />
            <Button x:Name="x_Add" Content="Submit" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ButtonStyleDefault}"></Button>
        </Grid>
    </Grid>
</ui:WslDialog>   
