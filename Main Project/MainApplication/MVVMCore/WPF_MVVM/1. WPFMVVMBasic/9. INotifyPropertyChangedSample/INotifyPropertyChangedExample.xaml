<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MVVMCore.INotifyPropertyChangedSample.INotifyPropertyChangedExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVMCore.INotifyPropertyChangedSample"
        mc:Ignorable="d"
        Title="INotifyPropertyChanged" Height="450" Width="800" WindowState="Normal" Left="8" Top="62">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Label Content="First Name" Grid.Row="0" Grid.Column="0" />
        <TextBox Width="250" Text="{Binding Path=FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25" Grid.Row="0" Grid.Column="1"/>
        <Label Content="Last Name" Grid.Row="1" Grid.Column="0" />
        <TextBox Width="250" Text="{Binding Path=LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25" Grid.Row="1" Grid.Column="1" />
        <Label Content="Full Name" Grid.Row="2" Grid.Column="0" />
        <TextBox Width="250" Text="{Binding Path=FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25" Grid.Row="2" Grid.Column="2" />
    </Grid>

</ui:WslDialog>
