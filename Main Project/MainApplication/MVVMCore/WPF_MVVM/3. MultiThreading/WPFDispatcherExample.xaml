<Window x:Class="MainApplication.WPF_MVVM._3._MultiThreading.WPFDispatcherExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM._3._MultiThreading"
        mc:Ignorable="d"
        Title="WPFDispatcherExample" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Name="x_Dispather" Content="Add" Height="30" Width="200" Background="AliceBlue" FontSize="14" Click="x_Dispather_Click"></Button>
        <Label Grid.Row="1" Name="LabelStatus" Height="30" Width="200" Margin="10"></Label>
    </Grid>
</Window>
