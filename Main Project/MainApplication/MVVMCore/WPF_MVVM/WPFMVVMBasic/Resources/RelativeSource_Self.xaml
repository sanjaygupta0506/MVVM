<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MainApplication.WPF_MVVM.WPFMVVMBasic.Resources.RelativeSource_Self"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Components="clr-namespace:MainApplication.WPF_MVVM.WPFMVVMBasic.Resources"
        xmlns:Models="clr-namespace:MainApplication.WPF_MVVM.Models"       
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM.WPFMVVMBasic.Resources"
        mc:Ignorable="d"
        Title="RelativeSource Self" Height="700" Width="800" Left="8" Top="62">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--Normal-->
        <Rectangle Grid.Row="0" Fill="Red" Name="rectangle"
                    Height="100" Stroke="Black"
                    Width="{Binding ElementName=rectangle,
                    Path=Height}"/>

        <!--RelativeSource Self-->
        <Rectangle Grid.Row="1" Fill="Blue" Height="100"
                   Stroke="Black"
                   Width="{Binding RelativeSource={RelativeSource Self}, Path=Height}"/>


        <TextBlock Grid.Row="2" Background="Yellow" Width="{Binding RelativeSource={RelativeSource Self},
                   Path=Parent.ActualWidth}"/>


    </Grid>
</ui:WslDialog>
