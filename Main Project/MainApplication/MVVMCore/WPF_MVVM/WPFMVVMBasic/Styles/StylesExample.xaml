<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MVVMCore.Styles.StylesExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVMCore.Styles"
        mc:Ignorable="d"
        Title="Styles Example" Height="350" Width="500" Left="8" Top="62">
    <ui:WslDialog.Resources>
        <!-- Implicit Styling-->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Teal"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Explicit Styling-->
        <Style TargetType="Button" x:Key="MyStyle">
            <Setter Property="Background" Value="Beige"/>
            <Setter Property="FontWeight" Value="Bold"/>

        </Style>
        <Style TargetType="Button" x:Key="MyStyle1">
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </ui:WslDialog.Resources>
    <Grid>
        <Button x:Name="x_Ok" Content="Ok__Implicit" Width="100" Height="30" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"></Button>
        <Button x:Name="x_Cancel" Content="Cancel__Implicit" Width="100" Height="30" Margin="150,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"></Button>
        
        <Button x:Name="x_Ok_Copy" Style="{StaticResource MyStyle}" Content="Ok__Explicit" Width="100" Height="30" Margin="10,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button x:Name="x_Cancel_Copy" Style="{StaticResource MyStyle1}" Content="Cancel__Explicit" Width="100" Height="30" Margin="150,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        
        <Button x:Name="x_Ok_Copy1" Content="Ok__Style__Individual" Width="240" Height="30" Margin="10,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Yellow"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</ui:WslDialog>
