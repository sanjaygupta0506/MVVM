<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MVVMCore.DataContext.DataContextExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVMCore.DataContext"
        mc:Ignorable="d"
        Title="Data Context Example" Height="300" Width="525" Left="8" Top="62">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="First Name" Grid.Row="0" Grid.Column="0" />
        <TextBox Width="250" Text="{Binding Path=FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" TextAlignment="Justify"/>
        <Label Content="Last Name" Grid.Row="1" Grid.Column="0" />
        <TextBox Width="250" Text="{Binding Path=LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" />
        <Label Content="Age" Grid.Row="2" Grid.Column="0" />
        <TextBox Width="250" Text="{Binding Path=Age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" />
    </Grid>
</ui:WslDialog>
