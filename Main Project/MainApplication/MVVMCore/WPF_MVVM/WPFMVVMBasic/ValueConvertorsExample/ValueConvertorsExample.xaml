<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MVVMCore.ValueConvertors.ValueConvertorsExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVMCore.ValueConvertors"
        xmlns:convertors="clr-namespace:MVVMCore.ValueConvertors"
        mc:Ignorable="d"
        Title="ValueConvertorsExample" Height="450" Width="800" Left="8" Top="62">
    <ui:WslDialog.Resources>
        <convertors:DateConvertor x:Key="myConvertor"></convertors:DateConvertor>
    </ui:WslDialog.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,5,5,5">
            <TextBlock x:Name="lblFirstName" Text="First Name"></TextBlock>
            <TextBox x:Name="txtName"></TextBox>
            <TextBlock x:Name="lblLastName" Text="Last Name"></TextBlock>
            <TextBox x:Name="txtAddress"></TextBox>
            <Button Grid.Column="0" Width="100" Height="35" Margin="5,5,5,5" x:Name="btnAdd" Click="btnAdd_Click" Content="Add"></Button>
        </StackPanel>
        <ListView x:Name="lstNames" Margin="5,5,5,5" Grid.Column="1" Grid.Row="0">
            <ListView.View>
                <GridView x:Name="grdNames">
                    <GridViewColumn Header="First Name"  DisplayMemberBinding="{Binding FirstName}"/>
                    <GridViewColumn Header="Last Name"  DisplayMemberBinding="{Binding LastName}"/>
                    <GridViewColumn Header="Full Name"  DisplayMemberBinding="{Binding FullName}"/>
                    <GridViewColumn Header="Date Added"  DisplayMemberBinding="{Binding DateAdded, Converter={StaticResource myConvertor}}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</ui:WslDialog>
