<Window  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MVVMCore.Commands.CommandsExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVMCore.Model"
        xmlns:CommandsModel="clr-namespace"
        mc:Ignorable="d"
        Title="Commands Example" Height="450" Width="800" Left="8" Top="62">
    <Window.Resources>
        <local:CommandsModel x:Key="vm"/>
    </Window.Resources>
    <Grid Name="pnlMainGrid" MouseUp="pnlMainGrid_MouseUp" Background="LightBlue">
        <Button x:Name="x_commandButton" Content="Command Button" Command="{Binding myCommand, Source={StaticResource vm}}" Height="40" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button.FontWeight>Bold</Button.FontWeight>
        </Button>
    </Grid>
</Window>
