<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MainApplication.WPF_MVVM.WPFMVVMBasic.Commands.Pages.ICommandExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication"
        xmlns:pages="clr-namespace:MainApplication.WPF_MVVM.WPFMVVMBasic.Commands.Pages"
        mc:Ignorable="d"
        Title="ICommandExample" Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="btnStyle" TargetType="Button">
                <Setter Property="Height" Value="60"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="Margin" Value="5,0"/>
            </Style>
        </ResourceDictionary>
        
        <DataTemplate x:Key ="pA">
            <pages:Page1 />
        </DataTemplate>
        <DataTemplate x:Key ="pB">
            <pages:Page2 />
        </DataTemplate>
        <DataTemplate x:Key ="pC">
            <pages:Page3 />
        </DataTemplate>
        <DataTemplate x:Key ="pD">
            <pages:Page4 />
        </DataTemplate>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Background="WhiteSmoke" >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnA" Content="A" Style="{StaticResource btnStyle}" Command="{Binding CMDChangePage}" CommandParameter="{x:Static local:PageId.A}"></Button>
                <Button x:Name="btnB" Content="B" Style="{StaticResource btnStyle}" Command="{Binding CMDChangePage}" CommandParameter="{x:Static local:PageId.B}"></Button>
                <Button x:Name="btnC" Content="C" Style="{StaticResource btnStyle}" Command="{Binding CMDChangePage}" CommandParameter="{x:Static local:PageId.C}"></Button>
                <Button x:Name="btnD" Content="D" Style="{StaticResource btnStyle}" Command="{Binding CMDChangePage}" CommandParameter="{x:Static local:PageId.D}"></Button>
            </StackPanel>
        </Grid>
        <ContentControl>
            <ContentControl.Style>
                <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="ContentTemplate" Value="{StaticResource pA}"/>
                    
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</ui:WslDialog>
