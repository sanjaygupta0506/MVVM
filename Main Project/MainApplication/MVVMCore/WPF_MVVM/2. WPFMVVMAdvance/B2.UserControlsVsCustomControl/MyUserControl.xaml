<UserControl x:Class="MainApplication.WPF_MVVM.WPFMVVMBasic.UserControlsExample.MyUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MainApplication.WPF_MVVM.WPFMVVMBasic.UserControlsExample"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="30">
        <TextBox Height = "30"  
         HorizontalAlignment = "Left"  
         Margin = "80,49,0,0" Name = "txtBox"  
         VerticalAlignment = "Top" Width = "400" />

        <Button Content = "Click Me" Width="150"  
         Height = "40" HorizontalAlignment = "Left"  
         Margin = "80,88,0,0" Name = "button"  
         VerticalAlignment = "Top" Click = "button_Click" />

    </Grid>
</UserControl>
