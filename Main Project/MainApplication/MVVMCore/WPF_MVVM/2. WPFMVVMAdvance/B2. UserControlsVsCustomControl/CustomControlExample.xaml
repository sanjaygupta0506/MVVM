<Window x:Class="MainApplication.WPF_MVVM._2._WPFMVVMAdvance.B2._UserControlsExample.CustomControlExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM._2._WPFMVVMAdvance.B2._UserControlsExample"
        xmlns:control="clr-namespace:MainApplication.WPF_MVVM._2._WPFMVVMAdvance.B2._UserControlsExample"
        mc:Ignorable="d"
        Title="CustomControlExample" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <control:MyCustomControl x:Name="customControl" Width="70" Margin="10" Click="customControl_Click"/>

            <TextBlock Name = "txtBlock"  
         Width = "250" Height = "30"/>
        </StackPanel>

    </Grid>
</Window>
