<Window x:Class="MainApplication.SecuritySample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1200" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="800"/>
           
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Menu x:Name="x_MainMenu" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="1" Height="25" VerticalAlignment="Top" Width="1200" HorizontalAlignment="Left" >

            
            <MenuItem Name="x_View" Header="View">
                <MenuItem Name="x_Themes" Header="Themes">
                    <MenuItem Name="x_caranuDark" Header="Caranu Dark" Click="x_caranuDark_Click"/>
                    <Separator />
                    <MenuItem Name="x_caranuLight" Header="Caranu Light" Click="x_caranuLight_Click" />
                </MenuItem>

                <Separator />

            </MenuItem>
          
        </Menu>
    </Grid>
</Window>
