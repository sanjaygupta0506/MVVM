<Window x:Class="MainApplication.WPF_MVVM._8._Interview.MostlyAsked_Coding.DataBindingExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM._8._Interview.MostlyAsked_Coding"
        mc:Ignorable="d"
        Title="DataBindingExample" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"/>

        <TextBlock Text="{Binding UserName}"
                   FontSize="20"
                   Foreground="Blue"/>
    </StackPanel>
</Window>
