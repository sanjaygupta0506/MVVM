<ui:WslDialog  xmlns:ui="clr-namespace:Keysight.Ccl.Wsl.UI;assembly=Keysight.Ccl.Wsl" x:Class="MainApplication.WPF_MVVM._8._Interview.MostlyAsked_Coding.DataTriggerExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApplication.WPF_MVVM._8._Interview.MostlyAsked_Coding"
        mc:Ignorable="d"
        Title="DataTriggerExample" Height="450" Width="800">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <CheckBox x:Name="chkStatus" Content="Click Me" FontSize="20" />
        <Button Content="Submit" Width="100" Height="30" FontSize="20" FontWeight="Bold">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Background" Value="Blue"/>
                    
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=chkStatus, Path=IsChecked}" Value="True">
                            <Setter Property="Foreground" Value="Orange"/>
                            <Setter Property="Background" Value="Yellow"/>
                            <Setter Property="FontWeight" Value="ExtraBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

        </Button>
    </StackPanel>
</ui:WslDialog>
